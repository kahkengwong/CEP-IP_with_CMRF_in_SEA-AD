    "decontx": {"path": "Part7_DecontX/decontX_contamination_all.csv"},
    "validation1": {"folder": ".", "recursive": true, "pattern": "^.*_{arm}_V1_{dataset}_SK_interaction_analysis\\.xlsx$"},
