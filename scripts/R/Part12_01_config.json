    "donor_clinical_s5b": {"folder": ".", "recursive": true, "pattern": "^{dataset}_S5b_donor_clinical\\.csv$"},
    "neuropath_table": {"folder": ".", "recursive": true, "pattern": "^sea-ad-quantitative-neuropathology-063026\\.xlsx$", "archive_fallback": true, "sheet": "Travaglini 2026 (multi-region)", "donor": "Donor ID", "region": "brain region", "analysis_region": "analysis region"},
    "cps_workbook": {"folder": ".", "recursive": true, "pattern": "^sea-ad_global_and_local_cps_050126\\.xlsx$", "archive_fallback": true, "sheet": "Travaglini 2026", "donor": "Donor ID", "region": "Brain Region"},
